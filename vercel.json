{
    "experimentalServices": {
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "entrypoint": "app.main:app"
        },
        "web": {
            "root": "web",
            "framework": "vite"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}